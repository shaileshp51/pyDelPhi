scale=2.0
grid_size=157
gridbox_type=cubic

in(modpdb4, file="./barnase-plus-probe.pqr", format="pqr")

select(name="BARNASE", cond="chain A")
select(name="ASP139", cond="chain B")
frc(source="BARNASE", target="ASP139", tmode="ignore", ofile="./focus_parent.frc")
 
out(phi, file="./parent.cube", media="water", format="cube")

indi=1.0
exdi=80.0
salt=0.15

boundary_condition=coulombic
max_delta_phi=1.0e-5
