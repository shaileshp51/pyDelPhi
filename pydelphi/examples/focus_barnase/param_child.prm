scale=4.0
grid_size=65

indi=1.0
exdi=80.0
salt=0.15
prbrad=1.4

bndcon=focusing !3 
maxc=0.00001

in(modpdb4, file="./barnase-plus-probe.pqr", format=pqr)
in(phi, file="./parent.cube", format=cube)

select(name="BARNASE", cond="chain A")
select(name="ASP139", cond="resname ASP and resid 139 and chain B")

acenter(sel="ASP139")
frc(source="BARNASE", target="ASP139", tmode="ignore", outfile="./focus.out32.frc")
site(a,q,p,f)
