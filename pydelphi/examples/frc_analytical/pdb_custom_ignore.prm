grid_size=161 
scale=8.0

in(pdb,file="./system.pdb")
in(crgsiz, name="custom", qfile="./custom.crg", rfile="./custom.siz")

select(name="SRC", condition="name N1 N2")
select(name="TGT", condition="not {name N1 N2}")

frc(
    source="SRC", 
    target="TGT",
    tmode="ignore", 
    outfile="./pdb_custom_ignore.frc"
)

indi=2.0
bndcon=coulombic
max_delta_phi=0.000001

site(a,q,f,p)
energy(polar,c,g)

out(sel, name="SRC", file="./pdb_custom_source.pqr")
out(sel, name="TGT", file="./pdb_custom_target.pqr")
