scale=2.0
perfil=60.0

in(modpdb4,file="{EXAMPLE_DIR}/lysozyme.pqr")

indi=4
exdi=80.0

!probe radius
prbrad=1.4
salt=0

bndcon=coulombic

!other run parameters
maxc=0.00001

! ZETA_POTENTIAL AND DISTANCE WORK ONLY WITH TWODIELECTRIC MODEL
! IF DIELECTRIC_MODEL=GAUSSIAN IT OVERRIDES ZETA_POTENTIAL.
!zeta_distance or zd=4 (must be > 0 and < 10)
zeta_potential=true
zeta_distance=4
out(zphi,file="{TMPDIR}/zeta_4A.zphi")

energy(p,c)

