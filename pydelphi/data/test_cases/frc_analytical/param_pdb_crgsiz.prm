grid_size=161 
scale=2.0

in(pdb, file="{EXAMPLE_DIR}/system.pdb")
in(crgsiz, set="custom", qfile="{EXAMPLE_DIR}/custom.crg", rfile="{EXAMPLE_DIR}/custom.siz")

select(name="SRC", condition="name N1 N2")
select(name="TGT", condition="not {name N1 N2}")

frc(
    source="SRC", 
    target="TGT",
    tmode="ignore", 
    outfile="{TMPDIR}/pdb_crgsiz.frc"
)

indi=2.0
bndcon=coulombic
max_delta_phi=0.000001

site(a,q,f,p)
energy(polar,c,g)
