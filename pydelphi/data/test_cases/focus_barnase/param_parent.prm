scale=2.0
grid_size=157
gridbox_type=cubic

in(modpdb4, file="{EXAMPLE_DIR}/barnase-plus-probe.pqr", format="pqr")

select(name="BARNASE", cond="chain A")
select(name="ASP139", cond="chain B")
frc(source="BARNASE", target="ASP139", tmode="ignore", ofile="{TMPDIR}/focus_parent.frc")
 
out(phi, file="{PARENT_PHI_FILE}", media="water", format="phi")

indi=1.0
exdi=80.0
salt=0.15

boundary_condition=coulombic
max_delta_phi=1.0e-5
